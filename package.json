{
  "name": "corpus-map",
  "version": "0.1.0",
  "description": "A React library that renders an embedded corpus as named territories, where the zoom level is the level of abstraction.",
  "type": "module",
  "main": "./dist/corpus-map.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertosca/corpus-map.git"
  },
  "keywords": [
    "react",
    "embeddings",
    "visualization",
    "map",
    "canvas",
    "semantic-zoom"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/corpus-map.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search.js"
    },
    "./assistant": {
      "types": "./dist/assistant/index.d.ts",
      "import": "./dist/assistant.js"
    },
    "./filter": {
      "types": "./dist/filter/index.d.ts",
      "import": "./dist/filter.js"
    },
    "./theme-check": {
      "types": "./dist/theme-check/index.d.ts",
      "import": "./dist/theme-check.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "vite build && vite build --config vite.search.config.ts && vite build --config vite.assistant.config.ts && vite build --config vite.filter.config.ts && vite build --config vite.theme-check.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.ts",
    "lint": "biome check . && eslint --max-warnings 0 .",
    "format": "biome format --write .",
    "api:check": "npm run build && node scripts/api-guard.mjs",
    "api:update": "npm run build && node scripts/api-guard.mjs --update",
    "size": "npm run build && node scripts/size.mjs",
    "size:badge": "npm run build && node scripts/size.mjs --write-badge"
  },
  "sizeLimit": {
    "file": "dist/corpus-map.js",
    "maximumGzipBytes": 37500,
    "search": {
      "file": "dist/search.js",
      "maximumGzipBytes": 4110
    },
    "assistant": {
      "file": "dist/assistant.js",
      "maximumGzipBytes": 2410
    },
    "filter": {
      "file": "dist/filter.js",
      "maximumGzipBytes": 2458
    },
    "themeCheck": {
      "file": "dist/theme-check.js",
      "maximumGzipBytes": 4000
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
